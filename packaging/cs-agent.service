[Unit]
Description=ComputeStacks Node Agent (cs-agent)
Documentation=https://github.com/computestacks/node-agent
# Wants=, not Requires=/BindsTo=: the agent does not need docker to start or to serve
# its API and firewall, and Requires= propagates every docker stop/restart to the agent.
# After= keeps boot ordering so the first firewall reconcile finds docker's chains.
Wants=docker.service network-online.target
After=docker.service network-online.target
ConditionPathExists=/etc/computestacks/agent.yml
# Never enter `failed`: a crash-looping agent keeps retrying every RestartSec
# (startup is cheap) instead of silently leaving the node unmanaged; the failure
# shows up as an unreachable agent rather than a stopped unit.
StartLimitIntervalSec=0

[Service]
# The agent sends READY=1 once its loops are running, and WATCHDOG=1 only while
# the dispatcher and firewall loops keep making progress. A wedged loop stops the
# keepalive; systemd then sends SIGABRT (Go dumps every goroutine stack to the
# journal) and restarts the agent.
Type=notify
NotifyAccess=main
WatchdogSec=30s
# Startup opens control.db and may run migrations before READY.
TimeoutStartSec=300
ExecStart=/usr/bin/cs-agent
Restart=always
RestartSec=5
SyslogIdentifier=cs-agent

# The agent is node infrastructure now: under memory pressure the kernel should kill
# customer containers before it. (Native systemd can apply this to the real process —
# the old `docker run` unit could not.)
OOMScoreAdjust=-900
Slice=cs-agent.slice

# Runs as root (needs the docker socket + NET_ADMIN for firewall). Further hardening
# (User=, AmbientCapabilities=CAP_NET_ADMIN, ProtectSystem=, etc.) is a follow-up once
# the exact privilege set is pinned down.

[Install]
WantedBy=multi-user.target
